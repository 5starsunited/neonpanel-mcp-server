{
  "name": "supply_chain_list_fba_replenishment_candidates",
  "description": "List items needing FBA replenishment based on projected stockout risk and inbound coverage.\n\nIMPORTANT — flat input: pass all parameters at top level. Do NOT use nested query/filters/tool_specific wrappers.\n\nRequired: company_id (integer). Calls without company_id are rejected by schema.\n\nCRITICAL: FBA inventory columns:\n- inbound: Amazon-reported units in transit TO FBA.\n- fc_transfer: Amazon-reported units transferring BETWEEN FBA centers.\n- available: Amazon-reported sellable FBA units.\n- fba_quantity_in_transit: NeonPanel control metric to validate Amazon inbound reporting.\n\nVELOCITY MODES (sales_velocity, default: 'current'):\n  • 'current': weighted blend of realized daily averages — by default 0.5×avg_30d + 0.3×avg_7d + 0.2×avg_3d, so recent 7d/3d trends adjust the 30-day rate. Override via velocity_weighting (e.g. {\"weight_30d\":1,\"weight_7d\":0,\"weight_3d\":0} to match the QuickSight 60.0 Inventory Planning 30-day average). ALWAYS tell the user which weights were used (returned in meta.velocity_weighting_used) and that they can supply their own.\n  • 'planned': averages forecast units over the coverage window (fba_lead_time + fba_safety_stock months) starting at the arrival month.\n  • 'target': uses daily_unit_sales_target.\n\nDefaults and behavior:\n- sales_velocity default is 'current'.\n- planning_base is auto-defaulted if omitted based on selector fields and sales_velocity.\n- fba_on_hand includes inbound + available + fc_transfer + fc_processing for replenishment planning.",
  "isConsequential": false,
  "inputSchema": {
    "type": "object",
    "properties": {
      "company_id": {
        "type": "integer",
        "minimum": 1,
        "description": "REQUIRED. Numeric company identifier."
      },
      "planning_base": {
        "type": "string",
        "enum": [
          "all",
          "targeted_only",
          "actively_sold_only",
          "planned_only"
        ],
        "description": "Which items to include in planning. Auto-defaulted if omitted."
      },
      "target_skus": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "target_inventory_ids": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "target_asins": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "parent_asins": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "brand": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "product_family": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "category": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "marketplaces": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "US",
            "UK",
            "ALL"
          ]
        },
        "default": [
          "ALL"
        ],
        "description": "Marketplace filter. Values: US, UK, ALL."
      },
      "countries": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "revenue_abcd_class": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "description": "Filter by revenue class."
      },
      "time_window": {
        "type": "object",
        "properties": {
          "lookahead_days": {
            "type": "integer",
            "minimum": 1,
            "default": 14
          },
          "as_of_date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD"
          }
        },
        "additionalProperties": false
      },
      "sales_velocity": {
        "type": "string",
        "enum": [
          "current",
          "target",
          "planned"
        ],
        "default": "current"
      },
      "velocity_weighting": {
        "type": "object",
        "description": "Blend weights for 'current' sales_velocity over realized daily averages. Defaults: 0.5/0.3/0.2 (30d/7d/3d). Pass {\"weight_30d\":1,\"weight_7d\":0,\"weight_3d\":0} to reproduce the plain 30-day average used by the QuickSight dashboard.",
        "properties": {
          "weight_30d": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5
          },
          "weight_7d": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.3
          },
          "weight_3d": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.2
          }
        },
        "additionalProperties": false
      },
      "use_seasonality": {
        "type": "boolean",
        "default": true
      },
      "override_default": {
        "type": "boolean",
        "default": false
      },
      "fba_lead_time_days_override": {
        "type": "integer",
        "minimum": 0,
        "default": 12
      },
      "fba_safety_stock_days_override": {
        "type": "integer",
        "minimum": 0,
        "default": 60
      },
      "days_between_shipments": {
        "type": "integer",
        "minimum": 0,
        "default": 14
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "default": 50
      },
      "stockout_threshold_days": {
        "type": "integer",
        "minimum": 0,
        "default": 7
      },
      "active_sold_min_units_per_day": {
        "type": "number",
        "minimum": 0,
        "default": 1
      }
    },
    "required": [
      "company_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "meta": {
        "type": "object",
        "properties": {
          "applied_sort": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "selected_fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "included_fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "required": [
      "items"
    ]
  },
  "examples": [
    {
      "description": "Basic US replenishment candidates",
      "request": {
        "company_id": 106,
        "marketplaces": [
          "US"
        ],
        "limit": 10
      }
    },
    {
      "description": "Planned velocity with tighter lead time",
      "request": {
        "company_id": 106,
        "sales_velocity": "planned",
        "fba_lead_time_days_override": 8,
        "fba_safety_stock_days_override": 45
      }
    },
    {
      "description": "Targeted ASINs for UK",
      "request": {
        "company_id": 106,
        "target_asins": [
          "B001234567",
          "B009876543"
        ],
        "marketplaces": [
          "UK"
        ]
      }
    }
  ]
}
