{
  "name": "orders_list_orders",
  "description": "Lists placed orders from sp_api_iceberg.orders_v2026 with filters. Returns one flattened row per order (no item expansion).\n\nUse this tool to:\n- Browse recent orders with status, marketplace, fulfillment detail\n- Look up specific orders by order_id\n- Filter orders by status, marketplace, seller, fulfillment channel, or date range\n- Get order_id values to feed into orders_get_order_details\n\nReturns: order_id, created_time, last_updated_time, marketplace, fulfillment status/channel/service_level, ship_by window, order_total, item_count.\n\nDefault window: last 3 months. Default limit: 50.",
  "isConsequential": false,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "properties": {
              "company_ids": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 },
                "minItems": 1,
                "description": "Company identifier(s) — required."
              },
              "order_ids": {
                "type": "array",
                "items": { "type": "string" },
                "maxItems": 100,
                "description": "Fetch specific orders by ID. When provided, date filters are ignored."
              },
              "marketplace_ids": { "type": "array", "items": { "type": "string" } },
              "order_statuses": {
                "type": "array",
                "items": { "type": "string", "enum": ["SHIPPED", "PENDING", "CANCELED", "UNSHIPPED", "PENDING_AVAILABILITY", "PARTIALLY_SHIPPED"] }
              },
              "fulfillment_channels": {
                "type": "array",
                "items": { "type": "string" },
                "description": "'AMAZON' for FBA. Omit for all."
              },
              "seller_ids": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["company_ids"],
            "additionalProperties": false
          },
          "aggregation": {
            "type": "object",
            "properties": {
              "time": {
                "type": "object",
                "properties": {
                  "start_date": { "type": "string", "format": "date" },
                  "end_date": { "type": "string", "format": "date" },
                  "periods_back": { "type": "integer", "minimum": 1, "maximum": 24, "default": 3 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        },
        "required": ["filters"],
        "additionalProperties": false
      }
    },
    "required": ["query"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "order_id":         { "type": "string" },
            "created_time":     { "type": "string" },
            "last_updated_time":{ "type": "string" },
            "marketplace_id":   { "type": ["string", "null"] },
            "marketplace_name": { "type": ["string", "null"] },
            "fulfillment_status":{ "type": ["string", "null"] },
            "fulfilled_by":     { "type": ["string", "null"] },
            "service_level":    { "type": ["string", "null"] },
            "ship_by_earliest": { "type": ["string", "null"] },
            "ship_by_latest":   { "type": ["string", "null"] },
            "order_total":      { "type": ["number", "null"] },
            "currency":         { "type": ["string", "null"] },
            "item_count":       { "type": ["integer", "null"] },
            "company_id":       { "type": "string" },
            "seller_id":        { "type": "string" }
          }
        }
      }
    },
    "required": ["items"]
  },
  "examples": [
    {
      "title": "Recent orders for a company",
      "request": {
        "query": {
          "filters": { "company_ids": [106] },
          "limit": 20
        }
      }
    },
    {
      "title": "Look up specific orders by ID",
      "request": {
        "query": {
          "filters": {
            "company_ids": [106],
            "order_ids": ["112-4809023-8655459", "701-7248689-5414620"]
          }
        }
      }
    },
    {
      "title": "Pending FBA orders in US",
      "request": {
        "query": {
          "filters": {
            "company_ids": [106],
            "marketplace_ids": ["ATVPDKIKX0DER"],
            "order_statuses": ["PENDING"],
            "fulfillment_channels": ["AMAZON"]
          }
        }
      }
    }
  ]
}
